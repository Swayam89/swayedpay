# Seed phrases: long random strings with no spaces. They fix each agent's address.
ORCHESTRATOR_SEED_PHRASE=
PLANNER_SEED_PHRASE=
SETTLEMENT_SEED_PHRASE=

# ASI:One API key (asi1.ai → Developer). Without it, SwayedPay falls back to rule-based parsing.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1

# Monetisation via the Agent Payment Protocol (Dorado testnet FET, no real money).
# off = settlement is free; settle_fee = charge SETTLE_FEE_FET before settling.
PAYMENT_MODE=off
SETTLE_FEE_FET=0.1

# Optional
ORCHESTRATOR_PORT=8010
PLANNER_PORT=8011
SETTLEMENT_PORT=8012
WORKER_TIMEOUT_SECONDS=30
